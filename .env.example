# GEMINI_API_KEY: Required for optional server-side Gemini AI quantitative advisory.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Binance Testnet credentials (server-side only, NEVER exposed to frontend)
# BINANCE_TESTNET_API_KEY=""
# BINANCE_TESTNET_API_SECRET=""
# BINANCE_FUTURES_TESTNET_API_KEY=""
# BINANCE_FUTURES_TESTNET_API_SECRET=""

# Safety Gate: Live real-money trading is strictly disabled by default
ALLOW_LIVE_TRADING="false"

# Optional SQLite database path (defaults to ./data/aegis_quant.sqlite)
# AEGIS_DB_PATH="./data/aegis_quant.sqlite"
